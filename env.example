# --- Turso (cloud DB) ---
TURSO_DATABASE_URL=libsql://myai-pancha2000.aws-ap-south-1.turso.io
TURSO_AUTH_TOKEN=your-turso-token

# --- Dashboard protection (set this on Koyeb!) ---
# If ADMIN_PASSWORD is set, the whole dashboard asks for a login (HTTP Basic).
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# --- Local AI (used only by worker.py on your laptop) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT=900

# --- Gatekeeper tuning (optional) ---
CACHE_TTL_DAYS=7
SEARCH_MAX_RESULTS=6
PAGES_TO_READ=3
